---
// Top ecosystem announcement bar
---
<div class="eco-bar">
  <div class="wrap eco-bar-inner">
    <span class="eco-bar-label">Bagian dari ekosistem Cardi</span>
    <nav class="eco-bar-nav" aria-label="Ekosistem Cardi">
      <a href="https://cardi.co.id/" target="_blank" rel="noopener">Cardi</a>
      <span class="eco-bar-sep">·</span>
      <a href="https://cardinusantara.com/" target="_blank" rel="noopener">Cardi Nusantara</a>
      <span class="eco-bar-sep">·</span>
      <a href="/" class="active">Cardi Agent</a>
      <span class="eco-bar-sep">·</span>
      <a href="https://cardi.co.id/toko/" target="_blank" rel="noopener">Toko Cardi</a>
    </nav>
  </div>
</div>

<style>
  .eco-bar {
    background: #060B18;
    color: #94A3B8;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 11.5px;
    font-weight: 500;
    padding: 7px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .eco-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .eco-bar-label {
    color: #64748B;
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  .eco-bar-nav {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .eco-bar-nav a {
    color: #94A3B8;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .eco-bar-nav a:hover,
  .eco-bar-nav a.active {
    color: #38BDF8;
  }
  .eco-bar-sep {
    color: rgba(255, 255, 255, 0.2);
  }
  @media (max-width: 640px) {
    .eco-bar-label {
      display: none;
    }
    .eco-bar-inner {
      justify-content: center;
    }
  }
</style>
