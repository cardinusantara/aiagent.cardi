---
interface Props {
  activeNav?: string;
}
const { activeNav = 'crm' } = Astro.props;
---
<nav id="mainNav">
  <div class="wrap navIn">
    <a class="brand" href="/" aria-label="Cardi Agent Beranda">
      <img src="/logos/agent-ai/logo-agent-ai-dark.png" alt="cardi agent." width="1151" height="368" />
    </a>

    <!-- Main Navigation Menu (CRM, MoM, Loyal, Harga) -->
    <div class="menu" role="menubar">
      <a href="/crm/" class={activeNav === 'crm' ? 'active' : ''} role="menuitem">CRM</a>
      <a href="/mom/" class={activeNav === 'mom' || activeNav === 'cardimom' ? 'active' : ''} role="menuitem">MoM</a>
      <a href="/loyal/" class={activeNav === 'loyal' || activeNav === 'cardiloyal' ? 'active' : ''} role="menuitem">Loyal</a>
      <a href="/#harga" class={activeNav === 'harga' ? 'active' : ''} role="menuitem">Harga</a>
    </div>

    <div class="navR">
      <!-- Bahasa Switcher (ID, EN, ZH) -->
      <div class="lang-dropdown-wrapper" id="langDropdownWrap">
        <button type="button" class="lang-toggle-btn" id="langToggleBtn" aria-expanded="false" aria-label="Pilih Bahasa" onclick="window.toggleLangDropdown(event)">
          <img id="currentLangFlag" src="/flags/id.svg" alt="ID" class="lang-flag-img" />
          <span id="currentLangCode" class="lang-code">ID</span>
          <svg class="lang-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="lang-dropdown-menu" id="langMenu">
          <button type="button" class="lang-option active" data-lang="id" onclick="window.setLanguage('id')">
            <img src="/flags/id.svg" alt="Bahasa Indonesia" class="lang-opt-flag" />
            <div class="lang-opt-info">
              <span class="lang-opt-name">Bahasa Indonesia</span>
              <span class="lang-opt-sub">ID (Indonesia)</span>
            </div>
            <svg class="lang-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>

          <button type="button" class="lang-option" data-lang="en" onclick="window.setLanguage('en')">
            <img src="/flags/en.svg" alt="English" class="lang-opt-flag" />
            <div class="lang-opt-info">
              <span class="lang-opt-name">English</span>
              <span class="lang-opt-sub">EN (Global)</span>
            </div>
            <svg class="lang-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>

          <button type="button" class="lang-option" data-lang="zh" onclick="window.setLanguage('zh')">
            <img src="/flags/zh.svg" alt="简体中文" class="lang-opt-flag" />
            <div class="lang-opt-info">
              <span class="lang-opt-name">简体中文</span>
              <span class="lang-opt-sub">ZH (Chinese)</span>
            </div>
            <svg class="lang-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>

      <!-- Rekrut Agent CTA Button -->
      <a class="btn" href="https://api.whatsapp.com/send?phone=6281289895646&text=Halo%20Cardi%20Agent!%20Saya%20ingin%20rekrut%20tim%20AI%20agent%20untuk%20bisnis%20saya.%20%F0%9F%A4%96" target="_blank" rel="noopener">
        Rekrut Agent
      </a>
    </div>

    <!-- Mobile Nav Actions (Language + Hamburger) -->
    <div class="mobile-nav-actions">
      <div class="lang-dropdown-wrapper mob-lang-header" id="mobLangDropdownWrap">
        <button type="button" class="lang-toggle-btn mob-lang-header-btn" id="mobLangToggleBtn" aria-expanded="false" aria-label="Pilih Bahasa" onclick="window.toggleMobLangDropdown(event)">
          <img id="mobLangFlag" src="/flags/id.svg" alt="ID" class="lang-flag-img" />
          <span id="mobLangCode" class="lang-code">ID</span>
          <svg class="lang-chevron" width="8" height="5" viewBox="0 0 10 6" fill="none">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="lang-dropdown-menu" id="mobLangMenu">
          <button type="button" class="lang-option active" data-lang="id" onclick="window.setLanguage('id')">
            <img src="/flags/id.svg" alt="Bahasa Indonesia" class="lang-opt-flag" />
            <div class="lang-opt-info">
              <span class="lang-opt-name">Bahasa Indonesia</span>
              <span class="lang-opt-sub">ID (Indonesia)</span>
            </div>
            <svg class="lang-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>

          <button type="button" class="lang-option" data-lang="en" onclick="window.setLanguage('en')">
            <img src="/flags/en.svg" alt="English" class="lang-opt-flag" />
            <div class="lang-opt-info">
              <span class="lang-opt-name">English</span>
              <span class="lang-opt-sub">EN (Global)</span>
            </div>
            <svg class="lang-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>

          <button type="button" class="lang-option" data-lang="zh" onclick="window.setLanguage('zh')">
            <img src="/flags/zh.svg" alt="简体中文" class="lang-opt-flag" />
            <div class="lang-opt-info">
              <span class="lang-opt-name">简体中文</span>
              <span class="lang-opt-sub">ZH (Chinese)</span>
            </div>
            <svg class="lang-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>

      <button class="burger-btn" id="burgerBtn" aria-label="Toggle navigation menu">
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
        <span class="bar bar-3"></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Navigation Drawer -->
<div class="mobile-nav-drawer" id="mobileNavDrawer">
  <div class="mobile-nav-links-wrap">
    <a href="/crm/" class={activeNav === 'crm' ? 'mobile-nav-link active' : 'mobile-nav-link'}>CRM</a>
    <a href="/mom/" class={activeNav === 'mom' || activeNav === 'cardimom' ? 'mobile-nav-link active' : 'mobile-nav-link'}>MoM</a>
    <a href="/loyal/" class={activeNav === 'loyal' || activeNav === 'cardiloyal' ? 'mobile-nav-link active' : 'mobile-nav-link'}>Loyal</a>
    <a href="/#harga" class={activeNav === 'harga' ? 'mobile-nav-link active' : 'mobile-nav-link'}>Harga</a>
  </div>

  <a class="btn" href="https://api.whatsapp.com/send?phone=6281289895646&text=Halo%20Cardi%20Agent!%20Saya%20ingin%20rekrut%20tim%20AI%20agent%20untuk%20bisnis%20saya.%20%F0%9F%A4%96" target="_blank" rel="noopener" style="width:100%; justify-content:center; margin-top:16px;">
    Rekrut Agent
  </a>
</div>

<script is:inline>
  window.toggleLangDropdown = function(e) {
    if (e) e.stopPropagation();
    var mobLangWrap = document.getElementById("mobLangDropdownWrap");
    if (mobLangWrap) mobLangWrap.classList.remove("open");
    var langWrap = document.getElementById("langDropdownWrap");
    var langBtn = document.getElementById("langToggleBtn");
    if (langWrap) {
      var isOpen = langWrap.classList.toggle("open");
      if (langBtn) langBtn.setAttribute("aria-expanded", String(isOpen));
    }
  };

  window.toggleMobLangDropdown = function(e) {
    if (e) e.stopPropagation();
    var langWrap = document.getElementById("langDropdownWrap");
    if (langWrap) langWrap.classList.remove("open");
    var mobLangWrap = document.getElementById("mobLangDropdownWrap");
    var mobLangBtn = document.getElementById("mobLangToggleBtn");
    if (mobLangWrap) {
      var isOpen = mobLangWrap.classList.toggle("open");
      if (mobLangBtn) mobLangBtn.setAttribute("aria-expanded", String(isOpen));
    }
  };

  document.addEventListener("click", function(e) {
    var langWrap = document.getElementById("langDropdownWrap");
    if (langWrap && !langWrap.contains(e.target)) {
      langWrap.classList.remove("open");
      var langBtn = document.getElementById("langToggleBtn");
      if (langBtn) langBtn.setAttribute("aria-expanded", "false");
    }
    var mobLangWrap = document.getElementById("mobLangDropdownWrap");
    if (mobLangWrap && !mobLangWrap.contains(e.target)) {
      mobLangWrap.classList.remove("open");
      var mobLangBtn = document.getElementById("mobLangToggleBtn");
      if (mobLangBtn) mobLangBtn.setAttribute("aria-expanded", "false");
    }
  });

  document.addEventListener("DOMContentLoaded", function() {
    var burger = document.getElementById("burgerBtn");
    var drawer = document.getElementById("mobileNavDrawer");
    if (burger && drawer) {
      burger.addEventListener("click", function(e) {
        e.stopPropagation();
        var isOpen = drawer.classList.toggle("open");
        burger.classList.toggle("open", isOpen);
      });
      drawer.querySelectorAll("a").forEach(function(link) {
        link.addEventListener("click", function() {
          drawer.classList.remove("open");
          burger.classList.remove("open");
        });
      });
    }
  });
</script>
