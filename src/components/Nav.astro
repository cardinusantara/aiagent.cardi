<script is:inline>
  window.toggleEcoDropdown = function(e) {
    if (e) e.stopPropagation();
    var langWrap = document.getElementById("langDropdownWrap");
    if (langWrap) langWrap.classList.remove("open");
    var mobLangWrap = document.getElementById("mobLangDropdownWrap");
    if (mobLangWrap) mobLangWrap.classList.remove("open");
    var ecoWrap = document.getElementById("navEcoDropdown");
    var ecoBtn = document.getElementById("navEcoTrigger");
    if (ecoWrap) {
      var isOpen = ecoWrap.classList.toggle("open");
      if (ecoBtn) ecoBtn.setAttribute("aria-expanded", String(isOpen));
    }
  };

  window.toggleLangDropdown = function(e) {
    if (e) e.stopPropagation();
    var ecoWrap = document.getElementById("navEcoDropdown");
    if (ecoWrap) ecoWrap.classList.remove("open");
    var mobLangWrap = document.getElementById("mobLangDropdownWrap");
    if (mobLangWrap) mobLangWrap.classList.remove("open");
    var langWrap = document.getElementById("langDropdownWrap");
    var langBtn = document.getElementById("langToggleBtn");
    if (langWrap) {
      var isOpen = langWrap.classList.toggle("open");
      if (langBtn) langBtn.setAttribute("aria-expanded", String(isOpen));
    }
  };

  window.toggleMobLangDropdown = function(e) {
    if (e) e.stopPropagation();
    var ecoWrap = document.getElementById("navEcoDropdown");
    if (ecoWrap) ecoWrap.classList.remove("open");
    var langWrap = document.getElementById("langDropdownWrap");
    if (langWrap) langWrap.classList.remove("open");
    var mobLangWrap = document.getElementById("mobLangDropdownWrap");
    var mobLangBtn = document.getElementById("mobLangToggleBtn");
    if (mobLangWrap) {
      var isOpen = mobLangWrap.classList.toggle("open");
      if (mobLangBtn) mobLangBtn.setAttribute("aria-expanded", String(isOpen));
    }
  };

  window.toggleMobEcoAccordion = function(e) {
    if (e) e.stopPropagation();
    var acc = document.getElementById("mobEcoAccordion");
    var btn = document.getElementById("mobEcoAccordionBtn");
    if (acc) {
      var isOpen = acc.classList.toggle("open");
      if (btn) btn.setAttribute("aria-expanded", String(isOpen));
    }
  };

  document.addEventListener("DOMContentLoaded", function() {
    var burgerBtn = document.getElementById("burgerBtn");
    var drawer = document.getElementById("mobileNavDrawer");
    var ecoWrap = document.getElementById("navEcoDropdown");
    var langWrap = document.getElementById("langDropdownWrap");
    var mobLangWrap = document.getElementById("mobLangDropdownWrap");
    var mainNav = document.getElementById("mainNav");

    function lockScroll(lock) {
      if (lock) {
        document.documentElement.style.overflow = "hidden";
        document.body.style.overflow = "hidden";
        document.body.style.touchAction = "none";
      } else {
        document.documentElement.style.overflow = "";
        document.body.style.overflow = "";
        document.body.style.touchAction = "";
      }
    }

    if (burgerBtn && drawer) {
      burgerBtn.addEventListener("click", function() {
        var open = burgerBtn.classList.toggle("active");
        drawer.classList.toggle("open", open);
        if (open) {
          if (mainNav) {
            var rect = mainNav.getBoundingClientRect();
            drawer.style.top = Math.max(0, Math.round(rect.bottom)) + "px";
            drawer.style.height = "calc(100dvh - " + Math.max(0, Math.round(rect.bottom)) + "px)";
          }
          lockScroll(true);
        } else {
          lockScroll(false);
        }
        if (mobLangWrap) mobLangWrap.classList.remove("open");
      });

      drawer.querySelectorAll("a").forEach(function(a) {
        a.addEventListener("click", function() {
          burgerBtn.classList.remove("active");
          drawer.classList.remove("open");
          lockScroll(false);
        });
      });
    }

    window.addEventListener("resize", function() {
      if (window.innerWidth > 900 && drawer && drawer.classList.contains("open")) {
        burgerBtn.classList.remove("active");
        drawer.classList.remove("open");
        lockScroll(false);
      }
    });

    // Desktop Hover support for Eco dropdown
    if (ecoWrap) {
      var hoverTimeout;
      ecoWrap.addEventListener("mouseenter", function() {
        if (window.innerWidth > 900) {
          clearTimeout(hoverTimeout);
          if (langWrap) langWrap.classList.remove("open");
          ecoWrap.classList.add("open");
          var btn = document.getElementById("navEcoTrigger");
          if (btn) btn.setAttribute("aria-expanded", "true");
        }
      });
      ecoWrap.addEventListener("mouseleave", function() {
        if (window.innerWidth > 900) {
          hoverTimeout = setTimeout(function() {
            ecoWrap.classList.remove("open");
            var btn = document.getElementById("navEcoTrigger");
            if (btn) btn.setAttribute("aria-expanded", "false");
          }, 150);
        }
      });
    }

    // Close on outside click
    document.addEventListener("click", function(e) {
      if (ecoWrap && !ecoWrap.contains(e.target)) {
        ecoWrap.classList.remove("open");
        var btn = document.getElementById("navEcoTrigger");
        if (btn) btn.setAttribute("aria-expanded", "false");
      }
      if (langWrap && !langWrap.contains(e.target)) {
        langWrap.classList.remove("open");
        var lbtn = document.getElementById("langToggleBtn");
        if (lbtn) lbtn.setAttribute("aria-expanded", "false");
      }
      if (mobLangWrap && !mobLangWrap.contains(e.target)) {
        mobLangWrap.classList.remove("open");
        var mlbtn = document.getElementById("mobLangToggleBtn");
        if (mlbtn) mlbtn.setAttribute("aria-expanded", "false");
      }
    });

    // Close on Escape key
    document.addEventListener("keydown", function(e) {
      if (e.key === "Escape") {
        if (ecoWrap) ecoWrap.classList.remove("open");
        if (langWrap) langWrap.classList.remove("open");
        if (mobLangWrap) mobLangWrap.classList.remove("open");
      }
    });
  });
</script>
