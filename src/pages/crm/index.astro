---
import Layout from '../../layouts/Layout.astro';
import AnnouncementBar from '../../components/AnnouncementBar.astro';
import Nav from '../../components/Nav.astro';
import TerminalHUD from '../../components/TerminalHUD.astro';
import Footer from '../../components/Footer.astro';
import MobileBar from '../../components/MobileBar.astro';

const WA_PILOT = 'https://api.whatsapp.com/send?phone=6281289895646&text=Halo%20Cardi%20Agent!%20Saya%20ingin%20rekrut%20tim%20AI%20Agent%20CRM%20untuk%20bisnis%20saya.%20%F0%9F%A4%96';
const WA_DEMO = 'https://api.whatsapp.com/send?phone=6281289895646&text=Halo%20Cardi%20Agent!%20Saya%20ingin%20jadwalkan%20live%20demo%20AI%20CRM.%20%F0%9F%98%81';
---

<Layout
  title="Cardi Agent · Tim AI CRM untuk Bisnis Indonesia"
  description="Agent yang bekerja di WhatsApp dan voice note tim kamu — mendatangkan lead, mencatat penjualan, menagih, dan membawa pelanggan kembali."
>
  <AnnouncementBar />
  <Nav activeNav="crm" />
  <TerminalHUD />

  <main class="crm-page-main">
    <!-- HERO SECTION -->
    <section class="hero-crm grid-bg">
      <div class="wrap hero-crm-wrap">
        <div class="hero-crm-copy">
          <div class="hero-pill mono">
            <img src="/logos/crm/icon-crm-app.png" alt="Cardi CRM" style="width:16px;height:16px;border-radius:4px;object-fit:cover;margin-right:6px;" />
            <span class="pulse-dot"></span>
            <span>Cardi Agent · Tim AI</span>
          </div>

          <h1 class="crm-title">
            Tim AI untuk <span class="em">bisnis Indonesia.</span>
          </h1>

          <p class="crm-lead">
            Agent yang bekerja di WhatsApp dan voice note tim kamu — mendatangkan lead, mencatat penjualan, menagih, dan membawa pelanggan kembali.
          </p>

          <div class="crm-cta-group">
            <a class="btn btn-primary" href="#divisi-ai">
              Lihat Cardi Agent AI ↓
            </a>
            <a class="btn btn-outline" href="https://cardi.co.id/cek-brand/" target="_blank" rel="noopener">
              Coba gratis: cek brand ↗
            </a>
          </div>

          <!-- Proof Metrics Strip -->
          <div class="crm-proof-strip">
            <div class="proof-item">
              <span class="proof-num">0 Detik</span>
              <span class="proof-lbl">Respon Lead Baru di WhatsApp</span>
            </div>
            <div class="proof-item">
              <span class="proof-num">100%</span>
              <span class="proof-lbl">Voice Note Sales Dicatat ke CRM</span>
            </div>
            <div class="proof-item">
              <span class="proof-num">+34%</span>
              <span class="proof-lbl">Pelunasan Piutang Tepat Waktu</span>
            </div>
          </div>
        </div>

        <!-- Interactive WhatsApp Simulation Preview -->
        <div class="hero-crm-sim">
          <div class="sim-phone-card">
            <div class="sim-header">
              <div class="sim-header-user">
                <div class="sim-avatar"><img src="/logos/crm/icon-crm-app.png" alt="Cardi CRM" style="width:100%;height:100%;border-radius:50%;object-fit:cover;display:block;" /></div>
                <div>
                  <div class="sim-name">Cardi AI Supervisor</div>
                  <div class="sim-status">Online • Terhubung WhatsApp</div>
                </div>
              </div>
              <span class="sim-badge-live">LIVE BOT</span>
            </div>

            <div class="sim-chat-body">
              <!-- Bubble 1: AI Briefing -->
              <div class="chat-bubble bot">
                <div class="bubble-tag">📊 Owner Brief · 19:00 WIB</div>
                <p><strong>Omzet hari ini: Rp 48,2 Jt</strong> (112% target) dari 37 kunjungan toko.</p>
                <div class="bubble-callout">
                  <span class="alert-tag">Perlu Perhatian</span>
                  <p>3 lead baru belum di-follow up. Toko Berkah Abadi tempo telat 6 hari — janji bayar Jumat.</p>
                </div>
                <div class="bubble-meta">19:00 • Terkirim otomatis</div>
              </div>

              <!-- Bubble 2: Owner Voice Note -->
              <div class="chat-bubble user">
                <div class="vn-player">
                  <span class="vn-play-btn">▶</span>
                  <div class="vn-wave"></div>
                  <span class="vn-dur">0:14</span>
                </div>
                <div class="vn-transcribe">
                  <em>"Tolong jadwalkan tim penagih sapa Toko Berkah besok pagi pakai link QRIS ya."</em>
                </div>
                <div class="bubble-meta me">19:02 • Anda</div>
              </div>

              <!-- Bubble 3: AI Action Completed -->
              <div class="chat-bubble bot">
                <p>✅ <strong>Siap, Pak!</strong> Draft penagihan sopan Rp 14.500.000 sudah disiapkan beserta QRIS statis Toko Berkah. Menunggu konfirmasi Anda untuk kirim jam 09:00 besok.</p>
                <div class="bubble-actions">
                  <span class="bubble-chip active">[Konfirmasi Kirim]</span>
                  <span class="bubble-chip">[Ubah Jadwal]</span>
                </div>
                <div class="bubble-meta">19:02 • AI Penagih Siap</div>
              </div>
            </div>

            <div class="sim-footer-note">
              <span class="sim-dot-pulse"></span> Berjalan langsung di WhatsApp resmi bisnis Anda
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CALLOUT BANNER: CEK BRAND -->
    <section class="crm-brand-strip">
      <div class="wrap crm-brand-inner">
        <div class="brand-strip-copy">
          <span class="strip-eyebrow mono">Eksklusif Ekosistem Cardi</span>
          <h3>Belum yakin mulai dari mana untuk bisnis Anda?</h3>
          <p>Cek brand gratis — kami arahkan ke tim agent yang tepat, atau ke tim konsultan Cardi Nusantara bila brand perlu diperkuat terlebih dahulu.</p>
        </div>
        <div class="brand-strip-action">
          <a class="btn btn-primary" href="https://cardi.co.id/cek-brand/" target="_blank" rel="noopener">
            Cek Brand Gratis Sekarang →
          </a>
        </div>
      </div>
    </section>

    <!-- 02. TIGA LINI DEPARTEMEN AGEN AI -->
    <section id="divisi-ai" class="crm-divisions-sec">
      <div class="wrap">
        <div class="sec-head-crm text-center">
          <span class="eyebrow-badge mono">Tiga Lini, Satu Perjalanan Pelanggan</span>
          <h2>Bukan Satu Chatbot, Tapi Satu Sistem yang Menjalankan Bisnisnya.</h2>
          <p class="sub-crm">Agent tidak menggantikan tim Anda, melainkan mengambil pekerjaan repetitif agar tim fokus closing dan melayani pelanggan.</p>
        </div>

        <div class="divisions-stack">
          <!-- LINI 01: MARKETING -->
          <div class="division-card-block">
            <div class="division-header">
              <div class="div-title-wrap">
                <span class="div-num mono">01</span>
                <div>
                  <h3 class="div-title">Marketing</h3>
                  <p class="div-desc">Lead masuk ditanggapi dalam hitungan detik, konten terjadwal, dan ulasan terkumpul.</p>
                </div>
              </div>
              <a href="/ai/marketing/" class="div-link-detail">Detail Marketing →</a>
            </div>

            <div class="agent-grid-cards">
              <div class="agent-card">
                <div class="agent-card-top">
                  <span class="agent-tag live">● Tersedia</span>
                  <span class="agent-category mono">Inbound</span>
                </div>
                <h4 class="agent-name">AI SDR (Sales Rep)</h4>
                <p class="agent-desc">Menjawab lead dari iklan IG & WhatsApp secara instan 24/7, mengkualifikasi budget, dan menjadwalkan meeting demo.</p>
                <div class="agent-kpi">
                  <span class="kpi-label">Diukur dari:</span>
                  <span class="kpi-val">Kecepatan respon & meeting tercatat</span>
                </div>
              </div>

              <div class="agent-card">
                <div class="agent-card-top">
                  <span class="agent-tag soon">○ Segera</span>
                  <span class="agent-category mono">Content</span>
                </div>
                <h4 class="agent-name">AI Konten</h4>
                <p class="agent-desc">Membuat ide, hook, caption, dan script video dari content pillar brand secara konsisten.</p>
                <div class="agent-kpi">
                  <span class="kpi-label">Diukur dari:</span>
                  <span class="kpi-val">Konten terbit per minggu</span>
                </div>
              </div>

              <div class="agent-card">
                <div class="agent-card-top">
                  <span class="agent-tag soon">○ Segera</span>
                  <span class="agent-category mono">Ads</span>
                </div>
                <h4 class="agent-name">AI Ads Reporter</h4>
                <p class="agent-desc">Laporan mingguan Meta & Google Ads dan keyword langsung ke WhatsApp tanpa perlu buka dashboard rumit.</p>
                <div class="agent-kpi">
                  <span class="kpi-label">Diukur dari:</span>
                  <span class="kpi-val">Biaya per lead & ROAS</span>
                </div>
              </div>

              <div class="agent-card">
                <div class="agent-card-top">
                  <span class="agent-tag soon">○ Segera</span>
                  <span class="agent-category mono">Live Stream</span>
                </div>
                <h4 class="agent-name">AI Live Follow-up</h4>
                <p class="agent-desc">Komentar & DM dari TikTok/IG Live diteruskan ke WhatsApp secara otomatis sampai tahap closing.</p>
                <div class="agent-kpi">
                  <span class="kpi-label">Diukur dari:</span>
                  <span class="kpi-val">Lead live yang closing</span>
                </div>
              </div>
            </div>
          </div>

          <!-- LINI 02: SALES -->
          <div class="division-card-block">
            <div class="division-header">
              <div class="div-title-wrap">
                <span class="div-num mono">02</span>
                <div>
                  <h3 class="div-title">Sales & Operasional</h3>
                  <p class="div-desc">Pipeline terisi sendiri dari chat & voice note, sales terpantau, dan tagihan tempo masuk tepat waktu.</p>
                </div>
              </div>
              <a href="/ai/sales/" class="div-link-detail">Detail Sales →</a>
            </div>

            <div class="agent-grid-cards">
              <div class="agent-card active-spotlight">
                <div class="agent-card-top">
                  <span class="agent-tag live">● Tersedia</span>
                  <span class="agent-category mono">Pipeline</span>
                </div>
                <h4 class="agent-name">AI Admin Sales</h4>
                <p class="agent-desc">Mencatat chat WhatsApp dan voice note sales jadi pipeline deal, surat pesanan, dan rute kunjungan toko.</p>
                <div class="agent-kpi">
                  <span class="kpi-label">Diukur dari:</span>
                  <span class="kpi-val">Jam admin yang dipangkas (hemat 3 jam/hari)</span>
                </div>
              </div>

              <div class="agent-card active-spotlight">
                <div class="agent-card-top">
                  <span class="agent-tag live">● Tersedia</span>
                  <span class="agent-category mono">Supervision</span>
                </div>
                <h4 class="agent-name">AI Supervisor</h4>
                <p class="agent-desc">Menilai kinerja sales, mengingatkan lead dingin yang terbengkalai, dan mengirim Owner Brief jam 19.00.</p>
                <div class="agent-kpi">
                  <span class="kpi-label">Diukur dari:</span>
                  <span class="kpi-val">Kecepatan respons sales & konversi</span>
                </div>
              </div>

              <div class="agent-card active-spotlight">
                <div class="agent-card-top">
                  <span class="agent-tag live">● Tersedia</span>
                  <span class="agent-category mono">Billing</span>
                </div>
                <h4 class="agent-name">AI Penagih Piutang</h4>
                <p class="agent-desc">Memberi skor risiko tempo tiap toko dan menagih bertahap dengan link QRIS — nominal disetujui manusia.</p>
                <div class="agent-kpi">
                  <span class="kpi-label">Diukur dari:</span>
                  <span class="kpi-val">Rupiah tagihan lunas tepat waktu</span>
                </div>
              </div>

              <div class="agent-card">
                <div class="agent-card-top">
                  <span class="agent-tag live">● Tersedia</span>
                  <span class="agent-category mono">Meeting</span>
                </div>
                <h4 class="agent-name">AI Notulen (Cardi MoM)</h4>
                <p class="agent-desc">Merangkum meeting dengan klien, mencatat kesepakatan, dan memasukkan hasilnya ke pipeline.</p>
                <div class="agent-kpi">
                  <span class="kpi-label">Diukur dari:</span>
                  <span class="kpi-val">Meeting tercatat & action items</span>
                </div>
              </div>
            </div>
          </div>

          <!-- LINI 03: RETENSI -->
          <div class="division-card-block">
            <div class="division-header">
              <div class="div-title-wrap">
                <span class="div-num mono">03</span>
                <div>
                  <h3 class="div-title">Retensi & Loyalitas</h3>
                  <p class="div-desc">Pelanggan kembali repeat order dan memberikan ulasan bintang 5 tanpa harus dikejar secara manual.</p>
                </div>
              </div>
              <a href="/loyal/" class="div-link-detail">Detail Loyalitas →</a>
            </div>

            <div class="agent-grid-cards">
              <div class="agent-card">
                <div class="agent-card-top">
                  <span class="agent-tag soon">○ Segera</span>
                  <span class="agent-category mono">Reactivation</span>
                </div>
                <h4 class="agent-name">AI Reaktivasi</h4>
                <p class="agent-desc">Menemukan pelanggan yang lama tidak order dan memprediksi kapan waktu tepat untuk restock.</p>
                <div class="agent-kpi">
                  <span class="kpi-label">Diukur dari:</span>
                  <span class="kpi-val">Pelanggan yang order kembali</span>
                </div>
              </div>

              <div class="agent-card active-spotlight">
                <div class="agent-card-top">
                  <span class="agent-tag live">● Tersedia</span>
                  <span class="agent-category mono">Loyalty & NFC</span>
                </div>
                <h4 class="agent-name">Cardi Agent AI Loyal</h4>
                <p class="agent-desc">Program poin, member, hadiah ultah, dan kartu NFC Google Review untuk F&B, retail, barbershop, & salon.</p>
                <div class="agent-kpi">
                  <span class="kpi-label">Diukur dari:</span>
                  <span class="kpi-val">Kenaikan repeat order & rating Google Maps</span>
                </div>
              </div>

              <div class="agent-card">
                <div class="agent-card-top">
                  <span class="agent-tag live">● Tersedia</span>
                  <span class="agent-category mono">Reviews</span>
                </div>
                <h4 class="agent-name">AI Review Booster</h4>
                <p class="agent-desc">Meminta dan membalas ulasan Google secara otomatis setelah transaksi selesai atau kunjungan toko.</p>
                <div class="agent-kpi">
                  <span class="kpi-label">Diukur dari:</span>
                  <span class="kpi-val">Jumlah & rating bintang 5 Google Maps</span>
                </div>
              </div>

              <div class="agent-card">
                <div class="agent-card-top">
                  <span class="agent-tag soon">○ Segera</span>
                  <span class="agent-category mono">Intelligence</span>
                </div>
                <h4 class="agent-name">AI Analis</h4>
                <p class="agent-desc">Menjawab pertanyaan owner seputar data pelanggan dan penjualan via voice note WhatsApp kapan saja.</p>
                <div class="agent-kpi">
                  <span class="kpi-label">Diukur dari:</span>
                  <span class="kpi-val">Kecepatan keputusan bisnis</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CARA PASANG -->
    <section class="crm-integration-sec">
      <div class="wrap">
        <div class="sec-head-crm text-center">
          <span class="eyebrow-badge mono">Fleksibel & Cepat</span>
          <h2>Cara Pasang: Tidak Perlu Ganti Sistem.</h2>
          <p class="sub-crm">Anda tidak dipaksa migrasi database atau belajar software baru yang rumit.</p>
        </div>

        <div class="integration-grid">
          <div class="integ-card">
            <div class="integ-num mono">01</div>
            <h3>Sistem Pendamping</h3>
            <p>Agent bekerja di atas sistem yang sudah kamu pakai — Google Sheets, Accurate, Jurnal Mekari, atau CRM existing.</p>
            <div class="integ-badge">Tinggal Sambungkan API / Webhook</div>
          </div>

          <div class="integ-card spotlight-integ">
            <div class="integ-num mono">02</div>
            <h3>Sistem Mandiri</h3>
            <p>Belum punya CRM? Pakai ruang kerja Cardi Agent sebagai kantor digital tempat semua agent beroperasi bersama tim.</p>
            <div class="integ-badge active-b">Pakai Workspace Cardi</div>
          </div>

          <div class="integ-card">
            <div class="integ-num mono">03</div>
            <h3>Done-For-You</h3>
            <p>Tim ahli Cardi Nusantara yang memasang, melatih flow chat sesuai SOP bisnis Anda, dan mengawasi kesehatan agent setiap bulan.</p>
            <div class="integ-badge">Full Setup Tanpa Repot</div>
          </div>
        </div>
      </div>
    </section>

    <!-- TABEL PERBANDINGAN -->
    <section class="crm-comparison-sec">
      <div class="wrap">
        <div class="sec-head-crm text-center">
          <span class="eyebrow-badge mono">Efisiensi Nyata</span>
          <h2>Admin Manusia Tetap Penting. Agent Mengambil Beban yang Membosankan.</h2>
        </div>

        <div class="table-card-wrap">
          <table class="comp-table">
            <thead>
              <tr>
                <th class="col-feature">Aspek Operasional</th>
                <th class="col-old">Cara Lama (Manual)</th>
                <th class="col-ai">Dengan Tim Cardi Agent AI</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="row-name">Rekap Laporan Sales</td>
                <td class="row-old">Disalin manual satu-satu dari grup WA di akhir hari</td>
                <td class="row-ai"><strong>Tercatat otomatis detik itu juga</strong> dari chat & voice note</td>
              </tr>
              <tr>
                <td class="row-name">Menagih Piutang Tempo</td>
                <td class="row-old">Sering sungkan, lupa jadwal, uang kas macet</td>
                <td class="row-ai"><strong>Bertahap, sopan, terjadwal rapi</strong> dengan link QRIS instan</td>
              </tr>
              <tr>
                <td class="row-name">Laporan ke Owner / Direksi</td>
                <td class="row-old">Menunggu akhir bulan baru tahu laba-rugi</td>
                <td class="row-ai"><strong>Executive Brief setiap malam jam 19.00</strong> langsung di WhatsApp</td>
              </tr>
              <tr>
                <td class="row-name">Jam Kerja & Respon Lead</td>
                <td class="row-old">Terbatas jam kantor, akhir pekan slow respon</td>
                <td class="row-ai"><strong>Aktif 24 jam nonstop</strong>, respon under 10 detik</td>
              </tr>
              <tr>
                <td class="row-name">Waktu Implementasi</td>
                <td class="row-old">Rekrut & onboarding karyawan 4-8 minggu</td>
                <td class="row-ai"><strong>Aktif dalam 3-5 hari kerja</strong> dengan SOP Anda</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- FAQ ACCORDION -->
    <section class="crm-faq-sec">
      <div class="wrap faq-crm-wrap">
        <div class="sec-head-crm text-center">
          <span class="eyebrow-badge mono">Transparansi & Keamanan</span>
          <h2>Pertanyaan yang Sering Muncul</h2>
        </div>

        <div class="faq-list">
          <details class="faq-item" open>
            <summary class="faq-q">
              <span>Apakah aman dengan kebijakan dan regulasi WhatsApp?</span>
              <span class="faq-icon">+</span>
            </summary>
            <div class="faq-a">
              <p>Sangat aman. Agent menggunakan integrasi WhatsApp Business API resmi milik nomor bisnis Anda sendiri. Tidak ada risiko banned karena interaksi didasarkan pada percakapan bisnis yang sah sesuai regulasi Meta.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-q">
              <span>Apakah saya harus mengganti sistem kasir atau akuntansi yang ada?</span>
              <span class="faq-icon">+</span>
            </summary>
            <div class="faq-a">
              <p>Tidak perlu. Cardi Agent dirancang modular untuk bekerja di atas sistem yang sedang berjalan, termasuk Google Sheets, Excel, Accurate, Jurnal Mekari, maupun software POS lainnya.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-q">
              <span>Bagaimana kalau agen AI salah menagih ke klien?</span>
              <span class="faq-icon">+</span>
            </summary>
            <div class="faq-a">
              <p>Nominal, batas tempo, dan pesan penagihan selalu menunggu persetujuan tim Anda ('Konfirmasi Kirim') sebelum terkirim ke debitur. Anda memegang kendali penuh.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-q">
              <span>Bagaimana dengan keamanan data pelanggan saya?</span>
              <span class="faq-icon">+</span>
            </summary>
            <div class="faq-a">
              <p>Data dienkripsi end-to-end dengan standar keamanan tinggi, akses diatur per peran otorisasi, dan seluruh pemrosesan mematuhi UU Pelindungan Data Pribadi (UU PDP) Indonesia.</p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- BOTTOM CTA HERO BANNER -->
    <section class="crm-final-cta">
      <div class="wrap">
        <div class="cta-banner-glass">
          <div class="cta-text-left">
            <div class="mono cta-badge-live">● PROGRAM PILOT 30 HARI</div>
            <h2>Siap Punya Tim AI yang Bekerja 24 Jam untuk Bisnis Anda?</h2>
            <p>Mulai dengan divisi yang paling Anda butuhkan hari ini. Setup cepat, pendampingan penuh dari tim teknis Cardi Nusantara.</p>
          </div>
          <div class="cta-action-right">
            <a class="btn btn-primary" href={WA_PILOT} target="_blank" rel="noopener">
              Daftar Program Pilot Sekarang →
            </a>
            <a class="btn btn-outline" href={WA_DEMO} target="_blank" rel="noopener">
              Jadwalkan Live Demo WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <MobileBar />
</Layout>

<style>
  /* CRM Dedicated Styling matching blueprint dark OS theme */
  .crm-page-main {
    background-color: #080C14;
    color: #E2E8F0;
    overflow-x: hidden;
  }

  .hero-crm {
    padding: 120px 0 80px;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .hero-crm-wrap {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  @media (max-width: 960px) {
    .hero-crm-wrap {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .hero-crm-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .crm-title {
    font-size: clamp(32px, 5vw, 54px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    margin: 0;
  }

