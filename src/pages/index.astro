  <script is:inline>
    // Case Studies Tabs Logic
    document.addEventListener('DOMContentLoaded', () => {
      const caseTabs = document.querySelectorAll('.case-tab');
      const caseContents = document.querySelectorAll('.case-content');

      caseTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          // Reset tabs
          caseTabs.forEach(t => t.classList.remove('active'));
          caseContents.forEach(c => c.classList.remove('active'));
          
          // Activate clicked
          tab.classList.add('active');
          const targetId = tab.getAttribute('data-target');
          document.getElementById(targetId).classList.add('active');
        });
      });

      const caseContentsList = document.querySelectorAll('.case-content');
      caseContentsList.forEach(content => {
        const viewBtns = content.querySelectorAll('.view-btn');
        const viewImgs = content.querySelectorAll('.case-img, .case-html-mockup');

        viewBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            // Reset buttons and elements in this specific case block
            viewBtns.forEach(b => b.classList.remove('active'));
            viewImgs.forEach(img => img.classList.remove('active'));

            // Activate clicked
            btn.classList.add('active');
            const targetView = btn.getAttribute('data-view');
            const targetEl = content.querySelector('#' + targetView);
            if(targetEl) targetEl.classList.add('active');
          });
        });
      });
    });
  </script>
