---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Nav from '../components/Nav.astro';
import TerminalHUD from '../components/TerminalHUD.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import DashboardMockup from '../components/DashboardMockup.astro';

const WA = 'https://api.whatsapp.com/send?phone=6281289895646&text=Halo%20Cardi%20Agent!%20Saya%20ingin%20jadwalkan%20demo%20untuk%20bisnis%20saya.%20%F0%9F%98%81';
---

<Layout>
  <AnnouncementBar />
  <Nav />
  <TerminalHUD />

  <!-- 02. HERO -->
  <section class="hero grid-bg" data-exec="00_boot.init">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="hero-pill mono">
          <span class="pulse-dot"></span> <span data-i18n="hero_pill">AI Agent untuk Bisnis · Ekosistem Cardi · Live 2026</span>
        </div>
        <h1 data-i18n="hero_h1">
          Pekerjaan yang menghabiskan<br />
          <span class="em" data-scramble>hari tim Anda,</span><br />
          dikerjakan agen AI.
        </h1>
        <p class="hero-sub" data-i18n="hero_sub">
          Cardi Agent membangun tim agen AI yang menangani penjualan, layanan pelanggan, penagihan, dan operasional harian — di WhatsApp, Instagram, email, sampai sistem internal Anda. Bukan satu chatbot, tapi <span class="hl">satu sistem yang menjalankan bisnisnya</span>.
        </p>
        <div class="heroCta">
          <a class="btn" href={WA} target="_blank" rel="noopener" data-i18n="hero_cta_btn">Jadwalkan Demo Gratis →</a>
          <a class="link-arrow" href="#cara-kerja" data-i18n="hero_cta_sub">Lihat sistemnya jalan ↓</a>
        </div>
        <div class="hero-note mono">
          <span data-i18n="hero_note">Belum yakin? <a href={WA} target="_blank" rel="noopener">Minta audit alur kerja gratis 30 menit →</a></span>
        </div>
      </div>

      <div class="hero-canvas-wrap">
        <canvas id="chipCanvas" aria-label="Diagram arsitektur Cardi Agent" role="img"></canvas>
      </div>
    </div>
  </section>

  <!-- 02.5. SHOWCASE & WORKFORCE -->
  <section id="showcase" class="grid-bg soft" data-exec="00b_showcase.render">
    <div class="wrap">
      <div class="eyebrow" data-i18n="cases_eyebrow">Dunia Nyata</div>
      <h2 class="h2" data-i18n="cases_h2">Apa yang dikerjakan Cardi Agent <span class="dim">24/7 di bisnis nyata.</span></h2>
      <p class="sub" data-i18n="cases_sub">Lihat bentuk asli sistem yang sedang berjalan menangani operasional harian.</p>

      <div class="showcase-grid reveal">
        <!-- Atas: Workforce Animasi -->
        <div class="showcase-col">
          <div class="showcase-card">
            <img src="/cases/preview%20djeonail.jpeg" alt="AI Agent Workspace" style="width: 100%; height: auto; display: block; border-radius: 12px 12px 0 0;">
            <div class="office-caption mono" style="background: #000; padding: 12px; border-top: 1px solid rgba(255,255,255,0.1); font-size: 11px; color: rgba(255,255,255,0.5); text-align: right;">cardi-agent-os · ai workforce online</div>
          </div>
          <p class="showcase-note" style="text-align: center;">
            <b>Setiap bisnis dikirim sebagai satu tim.</b> Bukan satu bot serba bisa, tapi beberapa agen AI yang bekerja di foldernya masing-masing menangani penjualan, laporan, dan tagihan.
          </p>
        </div>

        <!-- Kanan: Real Cases -->
        <div class="showcase-col">
          <div class="cases-container showcase-card">
            <div class="cases-tabs">
              <button class="case-tab active" data-target="case-surya">
                <span class="mono">01</span> Surya Painting
              </button>
              <button class="case-tab" data-target="case-mbg">
                <span class="mono">02</span> MBG
              </button>
            </div>

            <div class="case-content active" id="case-surya">
              <div class="case-metrics">
                <div class="metric"><span class="val">4.9</span>Rating CS</div>
                <div class="metric"><span class="val">12</span>Antrean Mobil</div>
                <div class="metric"><span class="val">100%</span>Auto-Follow Up</div>
              </div>
              <div class="case-views-nav">
                <button class="view-btn active" data-view="surya-backend">Backend</button>
                <button class="view-btn" data-view="surya-wa">WhatsApp</button>
                <button class="view-btn" data-view="surya-mobile">Mobile</button>
              </div>
              <div class="case-view-display">
                <img src="/cases/surya-dashboard.png" class="case-img active" id="surya-backend" alt="Surya Painting Dashboard" loading="lazy">
                <img src="/cases/surya-wa.png" class="case-img" id="surya-wa" alt="Surya Painting WhatsApp" loading="lazy">
                <img src="/cases/surya-mobile.png" class="case-img" id="surya-mobile" alt="Surya Painting Mobile" loading="lazy">
              </div>
            </div>

            <div class="case-content" id="case-mbg">
              <div class="case-metrics">
                <div class="metric"><span class="val">0%</span>Human Error PO</div>
                <div class="metric"><span class="val">&lt;10s</span>Waktu Respon</div>
                <div class="metric"><span class="val">180+</span>Invoice Harian</div>
              </div>
              <div class="case-views-nav">
                <button class="view-btn active" data-view="mbg-backend">Web Dashboard</button>
                <button class="view-btn" data-view="mbg-operations">MBG Operations</button>
                <button class="view-btn" data-view="mbg-sync">Alur Sinkronisasi</button>
              </div>
              <div class="case-view-display">
                <img src="/cases/Web%20Dashboard%20MBG.png" class="case-img active" id="mbg-backend" alt="MBG Web Dashboard" loading="lazy">
                <img src="/cases/MBG%20Operations.png" class="case-img" id="mbg-operations" alt="MBG Operations" loading="lazy">
                <img src="/cases/Alur%20Sinkronisasi.png" class="case-img" id="mbg-sync" alt="Alur Sinkronisasi MBG" loading="lazy">
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03. PIXEL MATRIX BAND -->
  <div class="pixel-band" data-exec="01_engine.render">
    <canvas id="pixelCanvas" aria-hidden="true"></canvas>
    <div class="pixel-caption mono">
      <div class="big" id="pixelCount">0</div>
      <div class="small" data-i18n="pixel_caption">tugas diselesaikan agen bulan ini</div>
    </div>
  </div>

  <!-- 04. PROBLEM -->
  <section id="masalah" data-exec="02_masalah.diagnose">
    <div class="wrap">
      <div class="eyebrow" data-i18n="masalah_eyebrow">Diagnosa</div>
      <h2 class="h2" data-i18n="masalah_h2">Bukan bisnis Anda yang salah. <span class="dim">Sistemnya yang hilang.</span></h2>

      <div class="problem-grid">
        <div class="problem-lines reveal">
          <p data-i18n="masalah_p1">Permintaan masuk dari lima kanal berbeda, dicatat di lima tempat berbeda.</p>
          <p data-i18n="masalah_p2">Tim Anda menghabiskan separuh hari untuk pekerjaan yang persis sama setiap hari.</p>
          <p data-i18n="masalah_p3">Calon pelanggan bertanya malam hari, dibalas besok pagi — kalau tidak terlewat.</p>
          <p data-i18n="masalah_p4">Penawaran yang sudah dikirim tidak pernah di-follow-up karena semua orang sibuk.</p>
          <p data-i18n="masalah_p5">Invoice jatuh tempo lewat seminggu sebelum ada yang sadar.</p>
          <p data-i18n="masalah_p6">Data berubah di satu sistem, sistem lain masih memakai angka lama.</p>
          <p data-i18n="masalah_p7">Setiap karyawan baru butuh sebulan sebelum paham cara kerja internal Anda.</p>
          <p data-i18n="masalah_p8">Laporan bulanan disusun manual, dan baru siap saat keputusannya sudah telat.</p>
          <p class="strong" data-i18n="masalah_p9">Anda tidak butuh lebih banyak orang untuk pekerjaan ini. Anda butuh <span class="hl">satu sistem yang menjalankannya sendiri.</span></p>
        </div>

        <div class="reveal">
          <div class="diagram-label"><span data-i18n="masalah_today_label">› Hari ini</span><span data-i18n="masalah_today_count">8 TEMPAT</span></div>
          <div class="scatter" id="scatter">
            <svg viewBox="0 0 400 150" preserveAspectRatio="none" aria-hidden="true">
              <line x1="70" y1="30" x2="200" y2="18" stroke="#6B7A9C" stroke-width="1" stroke-dasharray="3 4" opacity="0.5"></line>
              <line x1="70" y1="30" x2="90" y2="78" stroke="#6B7A9C" stroke-width="1" stroke-dasharray="3 4" opacity="0.5"></line>
              <line x1="240" y1="80" x2="150" y2="125" stroke="#6B7A9C" stroke-width="1" stroke-dasharray="3 4" opacity="0.5"></line>
              <line x1="240" y1="80" x2="310" y2="128" stroke="#6B7A9C" stroke-width="1" stroke-dasharray="3 4" opacity="0.5"></line>
              <text x="132" y="27" fill="#EF4444" font-size="11" font-family="monospace">✕</text>
              <text x="196" y="106" fill="#EF4444" font-size="11" font-family="monospace">✕</text>
            </svg>
            <span class="chip" style="left:0%; top:10%;" data-i18n="masalah_chip_wa">WHATSAPP</span>
            <span class="chip" style="left:47%; top:0%;" data-i18n="masalah_chip_sheet">SPREADSHEET</span>
            <span class="chip" style="left:8%; top:45%;" data-i18n="masalah_chip_email">EMAIL</span>
            <span class="chip" style="left:55%; top:42%;" data-i18n="masalah_chip_crm">CRM</span>
            <span class="chip" style="left:22%; top:78%;" data-i18n="masalah_chip_group">GRUP INTERNAL</span>
            <span class="chip" style="left:68%; top:80%;" data-i18n="masalah_chip_book">PEMBUKUAN</span>
          </div>
          <div class="diagram-caption" data-i18n="masalah_today_caption">Tidak ada yang saling terhubung</div>

          <div class="diagram-arrow">↓</div>

          <div class="diagram-label"><span data-i18n="masalah_os_label">› Dengan sebuah OS</span><span data-i18n="masalah_os_count">1 SISTEM</span></div>
          <div class="tree-window">
            <div class="tree-title"><span class="dot"></span> cardi-agent-os/</div>
            <div class="tree-row"><span class="box"></span> <span data-i18n="masalah_tree_channels">kanal/</span> <span class="rule"></span></div>
            <div class="tree-row"><span class="box"></span> <span data-i18n="masalah_tree_agents">agen/</span> <span class="rule"></span></div>
            <div class="tree-row"><span class="box"></span> <span data-i18n="masalah_tree_data">data/</span> <span class="rule"></span></div>
            <div class="tree-row"><span class="box"></span> <span data-i18n="masalah_tree_control">kendali/</span> <span class="rule"></span></div>
          </div>
          <div class="diagram-caption" data-i18n="masalah_os_caption">Satu sistem · semua terhubung</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05. LIVE DEMO -->
  <section id="cara-kerja" class="grid-bg soft" data-exec="03_sistem.render">
    <div class="wrap">
      <div class="eyebrow" data-i18n="demo_eyebrow">Live demo</div>
      <h2 class="h2" data-i18n="demo_h2">Lihat sistemnya jalan, <span class="dim">bukan cuma slide.</span></h2>
      <p class="sub" data-i18n="demo_sub">Ini bukan diagram. Ini graf pengetahuan yang benar-benar berjalan — 25 komponen, 41 relasi. Tarik node-nya, geser kanvasnya, klik untuk lihat tugas masing-masing.</p>

      <div class="kg reveal">
        <div class="demo-topbar mono">
          <span class="demo-dot"></span><span class="demo-dot"></span><span class="demo-dot"></span>
          <span style="margin-left:8px;">cardi-agent-os · knowledge graph</span>
          <span class="live-badge"><span class="pulse-dot"></span> LIVE</span>
        </div>

        <div class="kg-stage">
          <canvas id="kgCanvas"></canvas>

          <div class="kg-legend" id="kgLegend"></div>

          <div class="kg-controls">
            <button class="kg-btn" id="kgZoomOut" aria-label="Perkecil">−</button>
            <button class="kg-btn" id="kgZoomIn" aria-label="Perbesar">+</button>
            <button class="kg-btn wide" id="kgReset">RESET</button>
          </div>

          <div class="kg-hint mono">tarik node · geser kanvas · klik untuk detail</div>

          <div class="kg-panel" id="kgPanel">
            <button class="kg-panel-close" id="kgPanelClose" aria-label="Tutup">✕</button>
            <div class="kg-panel-tag"><span class="sw" id="kgPanelSw"></span><span id="kgPanelGroup"></span></div>
            <h5 id="kgPanelTitle"></h5>
            <p id="kgPanelDesc"></p>
            <div class="kg-panel-links" id="kgPanelLinks"></div>
          </div>
        </div>

        <div class="demo-footer mono">
          <span>$ os graph --live</span>
          <span class="accent">25 node · 41 relasi · milik Anda sejak hari pertama</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 06. TRANSPARENCY -->
  <section class="transparency" data-exec="04_bukti.open">
    <div class="wrap center">
      <p data-i18n="transparency_text">Cek sendiri sistemnya sebelum bayar. Kami jalankan demo memakai kasus nyata dari bisnis Anda — bukan video rekaman, bukan slide.</p>
      <a class="link-arrow" style="color:#8FA6FF;" href="https://cardi.co.id/" target="_blank" rel="noopener" data-i18n="transparency_link">Lihat ekosistem Cardi →</a>
    </div>
  </section>

  <!-- 07. ORIGIN STORY -->
  <section id="cerita" data-exec="05_origin.introduce">
    <div class="wrap">
      <div class="eyebrow" data-i18n="cerita_eyebrow">Kenapa ini dibangun</div>
      <h2 class="h2" data-i18n="cerita_h2">Kami capek lihat tim pintar <span class="dim">mengerjakan hal yang sama tiap hari.</span></h2>

      <div class="founder-grid">
        <div class="founder-copy reveal">
          <p data-i18n="cerita_p1">Cardi mulai dari tim yang ikut menjalankan operasional klien sendiri — bantu jualan, bantu follow-up, bantu rapikan laporan. Kami tahu persis rasanya kehabisan tangan sebelum kehabisan peluang.</p>
          <p data-i18n="cerita_p2">Jadi kami bangun sistemnya untuk dipakai sendiri dulu: beberapa agen AI yang menangani permintaan masuk, menyusun penawaran, menagih, dan menyiapkan laporan — tanpa perlu ditunggui.</p>
          <p data-i18n="cerita_p3">Setelah dipakai internal, waktu respons rata-rata turun ke <b class="ul">1,8 detik</b> dan konversi naik <b class="ul">58%</b>. Baru setelah itu kami buka untuk bisnis lain lewat Cardi Agent.</p>
        </div>

        <div class="reveal">
          <h3 style="font-size:20px; font-weight:700; letter-spacing:-0.02em; margin-bottom:18px;" data-i18n="cerita_timeline_title">Bayangkan 30 hari dari sekarang.</h3>
          <div class="timeline-item"><div class="timeline-time mono" data-i18n="timeline_t1">SEMALAMAN</div><div class="timeline-text" data-i18n="timeline_d1">Agen menangani setiap permintaan yang masuk sambil Anda tidur — tanpa satu pun menunggu pagi.</div></div>
          <div class="timeline-item"><div class="timeline-time mono" data-i18n="timeline_t2">07:00</div><div class="timeline-text" data-i18n="timeline_d2">Ringkasan semalam dan status pipeline masuk ke grup internal, otomatis.</div></div>
          <div class="timeline-item"><div class="timeline-time mono" data-i18n="timeline_t3">07:05</div><div class="timeline-text" data-i18n="timeline_d3">Anda baca dashboard 2 menit sambil ngopi — tahu apa yang perlu diputuskan hari ini.</div></div>
          <div class="timeline-item"><div class="timeline-time mono" data-i18n="timeline_t4">09:00</div><div class="timeline-text" data-i18n="timeline_d4">Tim mulai kerja dari pekerjaan yang benar-benar butuh manusia — sisanya sudah beres.</div></div>
          <div class="timeline-item"><div class="timeline-time mono" data-i18n="timeline_t5">SETELAH ITU</div><div class="timeline-text" data-i18n="timeline_d5">Jam yang biasanya habis untuk pekerjaan berulang, dipakai untuk produk dan strategi.</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 08. MECHANISM: 4 LAYERS -->
  <section id="fitur" class="grid-bg soft" data-exec="06_arsitektur.layers">
    <div class="wrap">
      <div class="eyebrow" data-i18n="layer_eyebrow">Arsitektur</div>
      <h2 class="h2" data-i18n="layer_h2">Empat lapisan yang bekerja sama, <span class="dim">bukan empat aplikasi terpisah.</span></h2>

      <div class="layer-grid">
        <div class="layer-card card reveal">
          <div class="layer-tag mono"><b>LAYER 01</b><span data-i18n="layer_1_tag">APA YANG DIKETAHUI</span></div>
          <h3 data-i18n="layer_1_title">Konteks</h3>
          <p data-i18n="layer_1_desc"><b>Bisnis Anda, dikodekan.</b> Produk, harga, SOP, dokumen internal, dan gaya bicara perusahaan jadi satu basis pengetahuan yang dipakai semua agen.</p>
          <div class="layer-example mono" data-i18n="layer_1_ex">Example: agen mengutip <b>syarat garansi</b> langsung dari kontrak Anda, bukan mengarang.</div>
        </div>
        <div class="layer-card card reveal">
          <div class="layer-tag mono"><b>LAYER 02</b><span data-i18n="layer_2_tag">SIAPA YANG MENGERJAKAN</span></div>
          <h3 data-i18n="layer_2_title">Agen</h3>
          <p data-i18n="layer_2_desc"><b>Pekerja AI dengan nama dan tugas.</b> Bukan satu bot serba bisa, tapi beberapa agen yang masing-masing menangani satu pekerjaan sampai tuntas.</p>
          <div class="layer-example mono" data-i18n="layer_2_ex">Example: <b>sales-agent</b> mengejar closing, <b>billing-agent</b> menagih, keduanya jalan bersamaan.</div>
        </div>
        <div class="layer-card card reveal">
          <div class="layer-tag mono"><b>LAYER 03</b><span data-i18n="layer_3_tag">APA YANG BISA DILAKUKAN</span></div>
          <h3 data-i18n="layer_3_title">Aksi</h3>
          <p data-i18n="layer_3_desc"><b>Bukan cuma menjawab, tapi bertindak.</b> Agen terhubung ke sistem Anda, jadi bisa menerbitkan invoice, update stok, dan mencatat order sungguhan.</p>
          <div class="layer-example mono" data-i18n="layer_3_ex">Example: order disetujui → invoice terbit → tercatat di pembukuan, <b>tanpa entri manual</b>.</div>
        </div>
        <div class="layer-card card reveal">
          <div class="layer-tag mono"><b>LAYER 04</b><span data-i18n="layer_4_tag">SIAPA YANG PEGANG KENDALI</span></div>
          <h3 data-i18n="layer_4_title">Kendali</h3>
          <p data-i18n="layer_4_desc"><b>Anda tetap memegang kemudi.</b> Setiap tindakan tercatat, batasnya Anda yang tentukan, dan pekerjaan bernilai besar selalu dilempar ke manusia dulu.</p>
          <div class="layer-example mono" data-i18n="layer_4_ex">Example: transaksi di atas <b>Rp 50 juta</b> wajib disetujui tim sebelum agen lanjut.</div>
        </div>
      </div>
      <p class="thesis" data-i18n="layer_thesis"><b>Kuasai empat lapisan ini dan Anda memiliki sistemnya, bukan menyewanya.</b> Model AI akan berganti, tools akan berganti — arsitektur ini yang tetap bertahan.</p>
    </div>
  </section>

  <!-- 09. FOLDER BROWSER -->
  <section id="untuk-siapa" data-exec="07_persona.browse">
    <div class="wrap">
      <div class="eyebrow" data-i18n="personas_eyebrow">Personas</div>
      <h2 class="h2" data-i18n="personas_h2">Setiap bisnis dikirim sebagai satu tim. <span class="dim">Buka foldernya, lihat rosternya.</span></h2>

      <div class="browser-shell reveal">
        <div class="browser-side" id="browserSide">
          <div class="browser-folder active" data-persona="fnb" data-i18n="persona_tab_retail">▸ retail-ecommerce.</div>
          <div class="browser-folder" data-persona="fashion" data-i18n="persona_tab_pro">▸ jasa-profesional.</div>
          <div class="browser-folder" data-persona="jasa" data-i18n="persona_tab_b2b">▸ distribusi-b2b.</div>
          <div class="browser-folder" data-persona="enterprise" data-i18n="persona_tab_enterprise">▸ enterprise.</div>
        </div>
        <div class="browser-main">
          <div class="browser-roster-title" id="browserRosterTitle" data-i18n="persona_roster_title">ROSTER · retail-ecommerce.</div>
          <div class="browser-roster" id="browserRoster">
            <span class="roster-chip">sales-agent</span>
            <span class="roster-chip">support-agent</span>
            <span class="roster-chip">billing-agent</span>
            <span class="roster-chip">stock-sync-agent</span>
            <span class="roster-chip">review-agent</span>
          </div>

          <div class="anatomy-grid">
            <div class="anatomy-col">
              <h4 data-i18n="anatomy_col1_title">01 · Root spine</h4>
              <li data-i18n="anatomy_col1_1">▭ reasoning-engine</li>
              <li data-i18n="anatomy_col1_2">▭ basis-pengetahuan</li>
              <li data-i18n="anatomy_col1_3">▭ sop-bisnis</li>
            </div>
            <div class="anatomy-col">
              <h4 data-i18n="anatomy_col2_title">02 · Blocks</h4>
              <li data-i18n="anatomy_col2_1">▦ kanal-masuk</li>
              <li data-i18n="anatomy_col2_2">▦ katalog-data</li>
              <li data-i18n="anatomy_col2_3">▦ integrasi-sistem</li>
            </div>
            <div class="anatomy-col">
              <h4 data-i18n="anatomy_col3_title">03 · Agents</h4>
              <li data-i18n="anatomy_col3_1">◦ sales-agent</li>
              <li data-i18n="anatomy_col3_2">◦ support-agent</li>
              <li data-i18n="anatomy_col3_3">◦ billing-agent</li>
              <li data-i18n="anatomy_col3_4">◦ ops-agent</li>
            </div>
            <div class="anatomy-col">
              <h4 data-i18n="anatomy_col4_title">04 · Skills</h4>
              <li data-i18n="anatomy_col4_1">✓ kualifikasi-lead</li>
              <li data-i18n="anatomy_col4_2">✓ susun-penawaran</li>
              <li data-i18n="anatomy_col4_3">✓ tagih-otomatis</li>
              <li data-i18n="anatomy_col4_4">✓ ringkasan-harian</li>
            </div>
          </div>
        </div>
      </div>
