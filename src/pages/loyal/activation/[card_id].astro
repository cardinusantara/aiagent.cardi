---
import '../../../styles/global.css';
import ActivationForm from '../../../components/ActivationForm';
import { supabase } from '../../../lib/supabase';
import type { Card } from '../../../lib/supabase';

export const prerender = false;

const { card_id } = Astro.params;
const rawCardId = card_id || '';
const cardId = decodeURIComponent(rawCardId).trim();

const isManage = Astro.url.searchParams.get('manage') === 'true';

const { data, error } = await supabase
  .from('cards')
  .select('*')
  .eq('card_id', cardId)
  .maybeSingle();

const card = data as Card | null;
const reviewUrl = card?.review_url || card?.google_review_url;

if (card && card.is_active && reviewUrl && !isManage) {
  return Astro.redirect(reviewUrl);
}
---

<!doctype html>
<html lang="id" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{card ? `Aktivasi Kartu #${cardId} | Cardi Loyal Review` : 'Kartu Tidak Ditemukan'}</title>
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <style is:global>
      /* Fallback style to ensure proper dimensions even before or without external CSS */
      svg {
        max-width: 100%;
        box-sizing: border-box;
      }
      .card-icon {
        width: 64px !important;
        height: 64px !important;
        max-width: 64px !important;
        max-height: 64px !important;
      }
    </style>
  </head>
  <body class="bg-zinc-950 text-zinc-100 font-sans antialiased min-h-screen">
    {(!card || error) ? (
      <main class="flex min-h-screen w-full items-center justify-center bg-zinc-950 p-4 sm:p-6">
        <div class="w-full max-w-md overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900 p-8 text-center shadow-xl">
          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-rose-950/50 text-rose-400 ring-8 ring-rose-950/30 mb-4" style="width: 80px; height: 80px; margin: 0 auto 16px auto;">
            <svg
              width="64"
              height="64"
              class="w-16 h-16 text-rose-500 mx-auto card-icon"
              style="width: 64px; height: 64px; max-width: 64px; max-height: 64px; display: block;"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div class="mt-2 inline-block rounded-full bg-zinc-800 px-3 py-1 font-mono text-xs font-semibold text-zinc-400">
            ID: #{cardId || 'UNKNOWN'}
          </div>
          <h1 class="mt-3 text-2xl font-bold tracking-tight text-white">
            Kartu Tidak Terdaftar
          </h1>
          <p class="mt-3 text-sm leading-relaxed text-zinc-400">
            Kartu dengan nomor identifikasi ini tidak ditemukan di database. Pastikan kode URL kartu sesuai atau hubungi admin Cardi Loyal.
          </p>
        </div>
      </main>
    ) : card.is_active && !reviewUrl && !isManage ? (
      <main class="flex min-h-screen w-full items-center justify-center bg-zinc-950 p-4 sm:p-6">
        <div class="w-full max-w-md overflow-hidden rounded-3xl border border-amber-900/40 bg-zinc-900 p-8 text-center shadow-xl">
          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-amber-950/50 text-amber-400 ring-8 ring-amber-950/30 mb-4" style="width: 80px; height: 80px; margin: 0 auto 16px auto;">
            <svg
              width="64"
              height="64"
              class="w-16 h-16 text-amber-500 mx-auto card-icon"
              style="width: 64px; height: 64px; max-width: 64px; max-height: 64px; display: block;"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div class="mt-2 inline-block rounded-full bg-zinc-800 px-3 py-1 font-mono text-xs font-semibold text-zinc-400">
            ID: #{cardId}
          </div>
          <h1 class="mt-3 text-2xl font-bold tracking-tight text-white">
            Tautan Ulasan Belum Siap
          </h1>
          <p class="mt-3 text-sm leading-relaxed text-zinc-400">
            Kartu ini telah aktif namun link Google Review belum tersimpan dengan lengkap.
          </p>
          <a
            href={`/loyal/activation/${cardId}?manage=true`}
            class="mt-6 inline-flex w-full items-center justify-center rounded-xl bg-white px-5 py-3 text-sm font-semibold text-zinc-900 shadow transition hover:bg-zinc-100"
          >
            Atur Ulang Profil Bisnis
          </a>
        </div>
      </main>
    ) : (
      <main class="relative flex min-h-screen w-full items-center justify-center overflow-hidden bg-gradient-to-br from-zinc-950 via-zinc-900 to-zinc-950 p-4 sm:p-6">
        <div aria-hidden="true" class="pointer-events-none absolute -top-40 -right-40 h-96 w-96 rounded-full bg-blue-600/10 blur-3xl" />
        <div aria-hidden="true" class="pointer-events-none absolute -bottom-40 -left-40 h-96 w-96 rounded-full bg-indigo-600/10 blur-3xl" />
        <div class="relative z-10 w-full flex justify-center">
          <ActivationForm client:load cardId={cardId} />
        </div>
      </main>
    )}
  </body>
</html>
