---
import MomLayout from '../../layouts/MomLayout.astro';
import CardProfileView from '../../components/mom/CardProfileView';

export const prerender = false;

const { username } = Astro.params;
const title = "Profil Kartu Bisnis Digital — Cardi Smart NFC";
const description = "Profil kartu bisnis digital resmi terhubung dengan Cardi Agent AI MoM.";
---

<MomLayout title={title} description={description}>
  <CardProfileView client:load username={username} />
</MomLayout>
