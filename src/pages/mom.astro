      let waText = "";
      if (currentLang === "zh") {
        waText = `您好 Cardi Agent MoM 开发团队，\n\n我想提交关于应用的意见与功能建议：\n• *分类：* ${category}\n• *姓名：* ${name}${role ? ` (${role})` : ""}\n`;
        waText += `\n*评论 / 缺点 / 建议：*\n"${message}"\n`;
      } else if (currentLang === "en") {
        waText = `Hello Cardi Agent MoM Dev Team,\n\nI would like to share feedback/feature suggestions for the app:\n• *Category:* ${category}\n• *Name:* ${name}${role ? ` (${role})` : ""}\n`;
        waText += `\n*Comments / Issues / Suggestions:*\n"${message}"\n`;
      } else {
        waText = `Halo Tim Pengembang Cardi Agent MoM,\n\nSaya ingin menyampaikan masukan dan evaluasi terkait kekurangan/fitur aplikasi:\n• *Kategori:* ${category}\n• *Nama:* ${name}${role ? ` (${role})` : ""}\n`;
        waText += `\n*Komentar / Kekurangan / Saran:*\n"${message}"\n`;
      }

      const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(waText)}`;
      window.open(url, "_blank", "noopener,noreferrer");
    }

    // Precise Smooth Scroll Navigation for all Internal Links
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener("click", function (e) {
        const targetId = this.getAttribute("href");
        if (!targetId || targetId === "#") return;

        if (targetId === "#top") {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: "smooth" });
          if (history.pushState) history.pushState(null, null, "#top");
          return;
        }

        const targetEl = document.querySelector(targetId);
        if (targetEl) {
          e.preventDefault();
          const navOffset = window.innerWidth <= 768 ? 86 : 98;
          const elementPos = targetEl.getBoundingClientRect().top;
          const targetOffset = elementPos + window.pageYOffset - navOffset;

          window.scrollTo({
            top: targetOffset,
            behavior: "smooth"
          });
          if (history.pushState) history.pushState(null, null, targetId);
        }
      });
    });

    // Initialize Language from Storage
    function initLanguage() {
      try {
        const savedLang = localStorage.getItem("cardi_lang") || "id";
        setLanguage(savedLang);
      } catch (e) {
        setLanguage("id");
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initLanguage);
    } else {
      initLanguage();
    }

    window.toggleLangDropdown = toggleLangDropdown;
    window.setLanguage = setLanguage;
    window.openWhatsApp = openWhatsApp;
    window.selectFeedbackCategory = selectFeedbackCategory;
    window.handleFeedbackSubmit = handleFeedbackSubmit;
    window.closeAllNavDropdowns = closeAllNavDropdowns;
  </script>
</body>
</html>
