    function closeAllNavDropdowns() {
      closeLangDropdown();
    }

    function toggleLangDropdown(event) {
      if (event) event.stopPropagation();
      const wrap = document.getElementById("langDropdownWrap");
      if (!wrap) return;
      const isOpen = wrap.classList.contains("open");
      
      if (isOpen) {
        closeLangDropdown();
      } else {
        wrap.classList.add("open");
      }
    }

    function closeLangDropdown() {
      const wrap = document.getElementById("langDropdownWrap");
      if (wrap) wrap.classList.remove("open");
    }

    document.addEventListener("click", (e) => {
      if (!e.target.closest(".lang-dropdown-wrapper")) {
        closeLangDropdown();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeAllNavDropdowns();
      }
    });

    function setLanguage(lang) {
      if (!translations[lang]) lang = "id";
      currentLang = lang;
      try {
        localStorage.setItem("cardi_lang", lang);
      } catch (err) {}

      document.documentElement.lang = lang === "zh" ? "zh-CN" : (lang === "en" ? "en" : "id");

      // Update all elements with data-i18n
      document.querySelectorAll("[data-i18n]").forEach((el) => {
        const key = el.getAttribute("data-i18n");
        if (translations[lang] && translations[lang][key] !== undefined) {
          el.innerHTML = translations[lang][key];
        }
      });

      // Update all inputs with data-i18n-ph
      document.querySelectorAll("[data-i18n-ph]").forEach((el) => {
        const key = el.getAttribute("data-i18n-ph");
        if (translations[lang] && translations[lang][key] !== undefined) {
          el.setAttribute("placeholder", translations[lang][key]);
        }
      });

      // Update Switcher UI labels & active items
      const flagSrcs = { id: "/flags/id.svg", en: "/flags/en.svg", zh: "/flags/zh.svg" };
      const codes = { id: "ID", en: "EN", zh: "ZH" };

      document.querySelectorAll(".lang-toggle-btn .lang-flag-img").forEach((el) => {
        el.src = flagSrcs[lang] || "/flags/id.svg";
        el.alt = codes[lang] || "ID";
      });
      document.querySelectorAll(".lang-toggle-btn .lang-code").forEach((el) => {
        el.textContent = codes[lang] || "ID";
      });

      document.querySelectorAll(".lang-select-item").forEach((item) => {
        if (item.getAttribute("data-lang") === lang) {
          item.classList.add("active");
        } else {
          item.classList.remove("active");
        }
      });

      closeLangDropdown();
    }

