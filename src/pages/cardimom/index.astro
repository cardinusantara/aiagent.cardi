---
import Layout from '../../layouts/Layout.astro';
import AnnouncementBar from '../../components/AnnouncementBar.astro';
import Nav from '../../components/Nav.astro';
import TerminalHUD from '../../components/TerminalHUD.astro';
import Footer from '../../components/Footer.astro';
import MobileBar from '../../components/MobileBar.astro';

const WA = "https://api.whatsapp.com/send?phone=6281289895646&text=Halo%20Cardi%20MoM!%20Saya%20tertarik%20mencoba%20notulen%20meeting%20otomatis.%20%F0%9F%8E%99%EF%B8%8F";
const title = "Cardi MoM — Notulen Meeting Otomatis & Task Dispatcher AI";
const description = "Cardi MoM: rekam atau unggah meeting, dapatkan notulen rapi dan action item terstruktur — langsung dikirim ke WhatsApp tim.";
---

<Layout title={title} description={description} activeNav="cardimom">
  <AnnouncementBar />
  <Nav activeNav="cardimom" />
  <TerminalHUD />

  <!-- HERO SECTION -->
  <section class="subbrand-hero grid-bg">
    <div class="wrap">
      <div class="hero-badge mono">
        <span class="pulse-dot"></span> Cardi MoM · AI Minutes of Meeting
      </div>
      <h1>
        Rapat selesai, <span class="em">notulen beres,</span><br />
        eksekusi langsung jalan.
      </h1>
      <p class="lead">
        Rekam lewat ponsel, Google Meet, Zoom, atau WhatsApp voice note. AI mentranskrip, merangkum poin krusial, dan langsung membagikan action items ke WhatsApp tim tanpa ada yang perlu mengetik manual.
      </p>
      <div style="display:flex; gap:16px; flex-wrap:wrap; align-items:center;">
        <a class="btn" href={WA} target="_blank" rel="noopener">Coba Demo Gratis via WhatsApp →</a>
        <a class="link-arrow" href="#cara-kerja">Lihat Cara Kerja ↓</a>
      </div>

      <!-- Proof Bar -->
      <div class="proof-bar reveal">
        <div class="proof-item">
          <span class="proof-num">99.2%</span>
          <span class="proof-lbl">Akurasi Transkripsi Bahasa Indonesia &amp; Slang</span>
        </div>
        <div class="proof-item">
          <span class="proof-num">&lt; 90 dtk</span>
          <span class="proof-lbl">Dari Rekaman Selesai ke PDF &amp; WhatsApp</span>
        </div>
        <div class="proof-item">
          <span class="proof-num">10.000+</span>
          <span class="proof-lbl">Menit Rapat Tim Diproses Setiap Bulan</span>
        </div>
        <div class="proof-item">
          <span class="proof-num">0</span>
          <span class="proof-lbl">Action Item yang Terlewat atau Terlupakan</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 01. CARA KERJA -->
  <section id="cara-kerja" class="grid-bg soft">
    <div class="wrap">
      <div class="eyebrow">Alur Kerja Otomatis</div>
      <h2 class="h2">Dari rekaman ke tindakan, <span class="dim">tanpa repot catat manual.</span></h2>
      <p class="sub">Lima langkah mulus dari obrolan rapat hingga tugas terdelegasi dengan jelas.</p>

      <ol class="steps-list">
        <li class="step-card reveal">
          <span class="step-badge mono">01</span>
          <h3>Rekam / Unggah</h3>
          <p>Bisa langsung rekam di HP, kirim voice note WhatsApp, atau undang bot ke Google Meet &amp; Zoom.</p>
        </li>
        <li class="step-card reveal">
          <span class="step-badge mono">02</span>
          <h3>Transkripsi Cerdas</h3>
          <p>Audio diubah menjadi teks akurat dengan pemisahan pembicara (speaker diarization).</p>
        </li>
        <li class="step-card reveal">
          <span class="step-badge mono">03</span>
          <h3>Sintesis Notulen</h3>
          <p>AI merangkum ringkasan eksekutif, keputusan penting, PIC, dan deadline yang disepakati.</p>
        </li>
        <li class="step-card reveal">
          <span class="step-badge mono">04</span>
          <h3>Distribusi WhatsApp</h3>
          <p>Format notulen rapi dan PDF profesional langsung dibagikan ke grup WhatsApp tim.</p>
        </li>
        <li class="step-card reveal">
          <span class="step-badge mono">05</span>
          <h3>Eskalasi ke Agent AI</h3>
          <p>Action item langsung dihubungkan ke Cardi Agent untuk follow-up dan pengingat otomatis.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 02. FITUR UNGGULAN -->
  <section class="grid-bg">
    <div class="wrap">
      <div class="eyebrow">Fitur Esensial</div>
      <h2 class="h2">Semua yang Anda butuhkan <span class="dim">setelah meeting selesai.</span></h2>

      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:24px; margin-top:40px;">
        <div class="card reveal" style="padding:30px;">
          <h3 style="font-size:20px; margin-bottom:12px;">Ringkasan AI &amp; Action Item</h3>
          <p>Memisahkan obrolan santai dari keputusan bisnis konkret, lengkap dengan penanggung jawab tugas.</p>
        </div>
        <div class="card reveal" style="padding:30px;">
          <h3 style="font-size:20px; margin-bottom:12px;">Ekspor PDF &amp; Dokumen Rapi</h3>
          <p>Satu klik untuk mengunduh dokumen notulen formal berlogo perusahaan, siap kirim ke direksi.</p>
        </div>
        <div class="card reveal" style="padding:30px;">
          <h3 style="font-size:20px; margin-bottom:12px;">Plugin Google Meet &amp; Zoom</h3>
          <p>Asisten AI otomatis hadir dan mencatat rapat virtual Anda tanpa perlu instal aplikasi berat.</p>
        </div>
        <div class="card reveal" style="padding:30px;">
          <h3 style="font-size:20px; margin-bottom:12px;">Voice Note to MoM</h3>
          <p>Kirim voice note WhatsApp setelah selesai visit klien, MoM langsung terbit dalam hitungan detik.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03. HARDWARE CARD SHOWCASE (SMART NFC CARD) -->
  <section class="grid-bg soft">
    <div class="wrap">
      <div class="hardware-box reveal">
        <div>
          <span class="nfc-badge">NFC HARDWARE INTEGRATION</span>
          <h3>Cardi Smart Business Card</h3>
          <p>
            Kartu nama fisik berteknologi NFC eksklusif. Tempelkan kartu ke smartphone rekan bisnis Anda — portofolio Anda langsung terbuka, dan percakapan pertemuan bisa langsung tersimpan ke sistem Cardi MoM.
          </p>
          <div style="display:flex; gap:14px; flex-wrap:wrap;">
            <a class="btn" href={WA} target="_blank" rel="noopener">Pesan Smart NFC Card →</a>
            <a class="link-arrow" href={WA} target="_blank" rel="noopener" style="color:#FFFFFF;">Aktivasi Kartu Fisik →</a>
          </div>
        </div>
        <div style="background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); border-radius:16px; padding:28px; text-align:center;">
          <div style="font-size:42px; margin-bottom:12px;">💳</div>
          <div style="font-family:var(--font-mono); font-size:16px; font-weight:700; color:#FFFFFF; margin-bottom:4px;">CARDI SMART CARD</div>
          <div style="font-size:13px; color:#93C5FD;">Tap &amp; Connect · Terhubung ke MoM</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04. PRICING TABLE -->
  <section id="harga" class="grid-bg">
    <div class="wrap">
      <div class="eyebrow">Skema Harga</div>
      <h2 class="h2">Mulai Rp 99 ribu per bulan. <span class="dim">Sederhana dan fleksibel.</span></h2>
      <p class="sub">Gunakan sistem coin yang transparan. Top-up kapan saja sesuai frekuensi meeting Anda.</p>

      <div class="table-wrap reveal">
        <table class="tbl">
          <thead>
            <tr>
              <th scope="col">Paket</th>
              <th scope="col">Starter</th>
              <th scope="col">Business</th>
              <th scope="col">Enterprise</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Biaya Bulanan</th>
              <td><b>Rp 99.000</b> / bulan</td>
              <td><b>Rp 599.000</b> / bulan</td>
              <td><b>Custom</b></td>
            </tr>
            <tr>
              <th scope="row">Coin Termasuk</th>
              <td>1.000 coin</td>
              <td>7.500 coin</td>
              <td>Tanpa batas</td>
            </tr>
            <tr>
              <th scope="row">Kanal Distribusi</th>
              <td>WhatsApp</td>
              <td>WhatsApp, Email, Webhook</td>
              <td>Integrasi Custom / API</td>
            </tr>
            <tr>
              <th scope="row">Platform Rapat</th>
              <td>Meet, Zoom &amp; VN WhatsApp</td>
              <td>Meet, Zoom &amp; VN WhatsApp</td>
              <td>Notion, Google Cal, Custom Flow</td>
            </tr>
            <tr>
              <th scope="row">Dukungan</th>
              <td>Standar Chat</td>
              <td>Prioritas WhatsApp</td>
              <td>Dedicated Account Manager</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="mono" style="margin-top:16px; font-size:13px; color:#64748B;">
        ℹ️ Catatan Coin: 1 coin = Rp 180 · Meeting 1 jam ≈ 182 coin. Paket top-up tersedia mulai Rp 90.000 (500 coin).
      </p>
    </div>
  </section>

  <!-- 05. FAQ -->
  <section class="grid-bg soft">
    <div class="wrap">
      <div class="eyebrow">FAQ</div>
      <h2 class="h2">Pertanyaan umum seputar <span class="dim">Cardi MoM.</span></h2>

      <div class="faq-wrap reveal">
        <div class="faq-item">
          <div class="faq-q">Apakah Cardi MoM aman dan menjaga kerahasiaan rapat kami?</div>
          <p class="faq-a">Sangat aman. Semua audio dan transkrip dienkripsi standar perbankan dan tidak pernah digunakan untuk melatih model publik. Rekaman hanya dapat diakses oleh tim Anda.</p>
        </div>
        <div class="faq-item">
          <div class="faq-q">Apakah bisa mengenali bahasa campuran (Indo-Inggris / Jaksel)?</div>
          <p class="faq-a">Bisa. Model AI kami dirancang khusus memahami dialek bisnis Indonesia, istilah teknis industri, hingga percakapan bilingual dengan akurasi tinggi.</p>
        </div>
        <div class="faq-item">
          <div class="faq-q">Bagaimana jika coin habis di tengah bulan?</div>
          <p class="faq-a">Anda bisa melakukan instant top-up kapan saja melalui WhatsApp tanpa perlu mengubah paket langganan Anda.</p>
        </div>
      </div>

      <!-- CTA Band -->
      <div class="cta-band reveal">
        <div>
          <h2>Mulai rapat lebih produktif hari ini.</h2>
          <p>Jangan biarkan ide dan komitmen penting rapat hilang tanpa eksekusi nyata.</p>
        </div>
        <div class="btns">
          <a class="btn" href={WA} target="_blank" rel="noopener">Coba Gratis via WhatsApp →</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <MobileBar />
</Layout>
