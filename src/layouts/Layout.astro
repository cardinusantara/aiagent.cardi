---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  activeNav?: 'home' | 'ai' | 'cardimom' | 'cardiloyal' | 'harga' | 'bantuan' | 'login' | 'pilot';
  bodyClass?: string;
}

const {
  title = 'Cardi Agent — Tim AI untuk Bisnis Indonesia',
  description = 'Cardi Agent: Cardi Agent AI (AI CRM), Cardi Agent AI MoM (notulen), dan Cardi Agent AI Loyal (loyalty & review).',
  canonical,
  activeNav = 'home',
  bodyClass = 't-agent',
} = Astro.props;

const currentUrl = canonical || Astro.url.href;
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={currentUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/style.css" />
</head>
<body class={bodyClass}>
  <a class="skip" href="#main">Lewati ke konten</a>
  
  <div class="eco">
    <div class="wrap eco-in">
      <span class="eco-label">Bagian dari ekosistem Cardi</span>
      <nav aria-label="Ekosistem Cardi">
        <a href="https://cardi.co.id/">Cardi</a>
        <a href="https://cardinusantara.com/">Cardi Nusantara</a>
        <a href="/" aria-current="true">Cardi Agent</a>
        <a href="https://cardi.co.id/toko/">Toko Cardi</a>
      </nav>
    </div>
  </div>

  <header class="hdr">
    <div class="wrap hdr-in">
      <a class="logo" href="/">
        <span class="logo-mark">CA</span>
        <span class="logo-name">Cardi Agent</span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mainnav" aria-label="Buka menu">
        <span></span><span></span><span></span>
      </button>
      <nav id="mainnav" class="nav" aria-label="Menu utama">
        <a href="/ai/" aria-current={activeNav === 'ai' ? 'page' : undefined}>Cardi Agent AI</a>
        <a href="/cardimom/" aria-current={activeNav === 'cardimom' ? 'page' : undefined}>MoM</a>
        <a href="/cardiloyal/" aria-current={activeNav === 'cardiloyal' ? 'page' : undefined}>Loyal</a>
        <a href="/ai/harga/" aria-current={activeNav === 'harga' ? 'page' : undefined}>Harga</a>
        <a href="/bantuan/" aria-current={activeNav === 'bantuan' ? 'page' : undefined}>Bantuan</a>
        <a class="nav-login" href="/login/">Masuk</a>
        <a class="btn btn-primary btn-sm" href="/ai/pilot/">Rekrut agent</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="ftr">
    <div class="wrap">
      <div class="f-top">
        <div class="f-brand">
          <a class="logo logo-light" href="https://cardi.co.id/">
            <span class="logo-mark">C</span>
            <span class="logo-name">Cardi</span>
          </a>
          <p>Dilihat, diingat, dipercaya — lalu dibeli. Ekosistem pertumbuhan bisnis Indonesia.</p>
          <a class="btn btn-ghost-light btn-sm" href="https://wa.me/6281289895646?text=Halo%20Cardi%2C%20saya%20ingin%20konsultasi.">WhatsApp 0812-8989-5646</a>
        </div>
        <div class="f-col">
          <h3>Cardi</h3>
          <a href="https://cardi.co.id/tentang/">Tentang</a>
          <a href="https://cardi.co.id/ekosistem/">Ekosistem</a>
          <a href="https://cardi.co.id/cek-brand/">Cek brand gratis</a>
          <a href="https://cardi.co.id/insight/">Insight</a>
          <a href="https://cardi.co.id/toko/">Toko Cardi</a>
          <a href="https://cardi.co.id/karier/">Karier</a>
          <a href="https://cardi.co.id/deo-cardi-nathanael-profile/">Founder</a>
        </div>
        <div class="f-col">
          <h3>Cardi Nusantara</h3>
          <a href="https://cardinusantara.com/branding/">Branding</a>
          <a href="https://cardinusantara.com/digital/">Digital</a>
          <a href="https://cardinusantara.com/gtm/">Go-to-Market</a>
          <a href="https://cardinusantara.com/ipo-partner/">IPO Partner</a>
          <a href="https://cardinusantara.com/portofolio/">Portofolio</a>
          <a href="https://cardinusantara.com/brief/">Kirim brief</a>
        </div>
        <div class="f-col">
          <h3>Cardi Agent</h3>
          <a href="/ai/">Cardi Agent AI</a>
          <a href="/cardimom/">Cardi Agent AI MoM</a>
          <a href="/cardiloyal/">Cardi Agent AI Loyal</a>
          <a href="/ai/harga/">Harga</a>
          <a href="/ai/pilot/">Program pilot</a>
          <a href="/bantuan/">Bantuan</a>
        </div>
      </div>
      <div class="f-bot">
        <span>© 2026 PT Digital Cardi Nusantara · Jakarta</span>
        <span>cardi.co.id · cardinusantara.com · aiagent.cardi.co.id</span>
      </div>
    </div>
  </footer>

  <a class="wa-float" href="https://wa.me/6281289895646?text=Halo%20Cardi%2C%20saya%20ingin%20tanya." aria-label="Chat WhatsApp">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 20l1.3-3.9A8 8 0 1 1 8 19z"></path>
    </svg>
  </a>

  <script is:inline src="/assets/main.js"></script>
</body>
</html>
